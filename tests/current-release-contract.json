{
  "version": "1.4.0-alpha.54",
  "milestone_name": "Lock Evidence Review CLI + Digest Reader",
  "release_type": "product-facing",
  "allowed_scope": [
    "read-only lock evidence review CLI for ZIP or extracted lock bundles",
    "digest reader summary for reviewer decision, gate status, and evidence counts",
    "checksum manifest validation for release-lock dashboard digest files during review",
    "operator next-action guidance from canonical dashboard digest data",
    "deterministic CLI tests for directory and ZIP lock evidence inputs without runtime behavior change"
  ],
  "forbidden_scope": [
    "live provider calls",
    "OAuth/token lifecycle changes",
    "backend/storage behavior changes",
    "source-fetching or scraping behavior changes",
    "automatic source verification",
    "automatic signoff or export lock",
    "cryptographic signature claims",
    "publication permission claims",
    "status persistence",
    "batch mutation",
    "navigation-state persistence",
    "provider execution expansion",
    "new adapter replay review-pack surface",
    "new source-to-brief decision surface beyond evidence capture"
  ],
