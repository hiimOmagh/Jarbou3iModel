diff -ruN alpha23_work/tests/changed-files-patch-hygiene-guard-lock-completion-check.mjs alpha24_work/tests/changed-files-patch-hygiene-guard-lock-completion-check.mjs
--- alpha23_work/tests/changed-files-patch-hygiene-guard-lock-completion-check.mjs	1970-01-01 00:00:00.000000000 +0000
